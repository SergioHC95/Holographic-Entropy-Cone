{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hec:repository-storage:2",
  "title": "HEC repository storage inventory (not mathematical acceptance)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "entries"],
  "properties": {
    "format": {"const": "hec-repository-storage/2"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "pattern": "^data/n=[1-9][0-9]*/((facets|rays|graphs|inequalities|proofs)\\.json|proof-shards/[0-9a-f]{64}\\.proofpack)$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 104857600}
        }
      }
    }
  }
}
