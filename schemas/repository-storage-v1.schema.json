{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hec:repository-storage:1",
  "title": "HEC repository storage inventory (not mathematical acceptance)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "entries"],
  "properties": {
    "format": {"const": "hec-repository-storage/1"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "storage"],
        "properties": {
          "path": {"type": "string", "pattern": "^(data/|archives/contractions/)[A-Za-z0-9=._/-]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "storage": {"enum": ["git", "lfs"]}
        }
      }
    }
  }
}
