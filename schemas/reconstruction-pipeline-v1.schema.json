{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hec:compatible-reconstruction-pipeline:1",
  "title": "Proposed opt-in reconstruction function in the exact count-proof envelope",
  "description": "Syntax is not mathematical acceptance. Production registration and complete-corpus conversion are separate gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "inequality", "function", "clearing_scale"],
  "properties": {
    "format": {"const": "hec-count-proof/1"},
    "inequality": {"$ref": "count-proof-v1.schema.json#/properties/inequality"},
    "clearing_scale": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "minimal"],
      "properties": {"value": {"$ref": "#/$defs/positive"}, "minimal": {"const": false}}
    },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "seed", "extension"],
      "properties": {
        "kind": {"const": "compatible-reconstruction-pipeline/1"},
        "extension": {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": {"kind": {"const": "cancel-fill-common-threshold/1"}}
        },
        "seed": {
          "oneOf": [
            {"$ref": "#/$defs/table"}, {"$ref": "#/$defs/dag"},
            {"$ref": "#/$defs/cuts"}, {"$ref": "#/$defs/closure"}
          ]
        }
      }
    }
  },
  "$defs": {
    "positive": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "natural": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "index": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/index"}},
    "table": {
      "type": "object", "additionalProperties": false, "required": ["kind", "rows"],
      "properties": {
        "kind": {"const": "compatible-count-table/1"},
        "rows": {"$ref": "count-proof-v1.schema.json#/properties/function/oneOf/0/properties/rows"}
      }
    },
    "dag": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "scale", "terminals", "nodes", "roots"],
      "properties": {
        "kind": {"const": "compatible-scalar-dag/1"},
        "scale": {"$ref": "#/$defs/positive"},
        "terminals": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/natural"}},
        "nodes": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/index"}}
        },
        "roots": {"type": "array", "items": {"$ref": "#/$defs/index"}}
      }
    },
    "cuts": {
      "type": "object", "additionalProperties": false, "required": ["kind", "terms", "groups"],
      "properties": {
        "kind": {"const": "integer-cut-dnf/1"},
        "terms": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/natural"}}
        },
        "groups": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/refs"}}}
      }
    },
    "closure": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "anchors", "enumeration", "pairs", "policy", "choice_count", "exceptions"],
      "properties": {
        "kind": {"const": "integer-interval-closure/1"},
        "anchors": {"type": "integer", "minimum": 0, "maximum": 128},
        "enumeration": {"type": "integer", "minimum": 0, "maximum": 1024},
        "pairs": {"type": "boolean"},
        "policy": {"enum": ["lower", "upper"]},
        "choice_count": {"$ref": "#/$defs/index"},
        "exceptions": {
          "type": "array",
          "items": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "prefixItems": [{"$ref": "#/$defs/index"}, {"$ref": "#/$defs/natural"}]
          }
        }
      }
    }
  }
}
